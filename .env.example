# ============ Hạ tầng ============
DATABASE_URL=postgresql+psycopg://reup:reup@localhost:5432/reup
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./media
API_BASE_URL=http://localhost:8000

# ============ AI: dịch thuật ============
# anthropic | openai | mock
# Dùng "openai" cho MỌI nhà cung cấp nói giao thức /chat/completions của
# OpenAI — Gemini, Groq, OpenRouter, DeepSeek, Ollama. Đổi nhà cung cấp chỉ
# cần đổi 3 dòng dưới, không sửa code.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BATCH_SIZE=25
# Trần hạn mức TỰ KHAI. Gemini không trả header hạn mức nào qua API nên hệ
# thống không hỏi được nhà cung cấp — phải tự đếm. Đọc số thật của dự án bạn ở
# aistudio.google.com/rate-limit rồi điền vào đây. 0 = không giới hạn.
# Ví dụ gemini-3.5-flash-lite (bậc miễn phí): 15 lượt/phút, 500 lượt/ngày.
LLM_MAX_REQUESTS_PER_MIN=0
LLM_MAX_REQUESTS_PER_DAY=0

# Địa chỉ gốc của API. Bỏ trống = dùng OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
#   Gemini (bậc miễn phí, key lấy ở aistudio.google.com, không cần thẻ):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-3.6-flash
#   Groq (bậc miễn phí, không cần thẻ — trần 6.000 token/phút, chật với video dài):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama chạy tại máy (không key, không giới hạn):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_API_KEY=ollama

# ============ AI: nhận dạng giọng nói ============
# tiny | base | small | medium | large-v3
# Máy KHÔNG có GPU NVIDIA (ví dụ Mac): để small. large-v3 phải tải ~3GB weight
# lần chạy đầu rồi chạy trên CPU — chậm gấp nhiều lần, không dùng nổi để thử.
# Máy có GPU: đổi thành large-v3.
WHISPER_MODEL=small
# cuda | cpu | auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16

# ============ Phụ đề ============
SUB_FONT=Be Vietnam Pro
# Pixel ở khung chuẩn 1080×1920; khung khác tự quy đổi theo tỉ lệ chiều cao.
# 104 ≈ 5,4% chiều cao — cỡ thông dụng của video ngắn.
SUB_FONT_SIZE=104
# Đi kèm cỡ chữ ở trên. Chữ to hơn thì số ký tự mỗi dòng phải nhỏ đi.
SUB_MAX_CHARS_PER_LINE=22
SUB_MAX_LINES=2
SUB_MIN_DURATION=1.2

# ============ Chống trùng ============
DEDUP_ENABLED=true
# Đổi số khung = mọi pHash cũ trong DB hết so sánh được
DEDUP_PHASH_FRAMES=4
# Số bit khác nhau tối đa trên tổng 4×64=256 bit; càng nhỏ càng chặt
DEDUP_PHASH_MAX_DISTANCE=20
DEDUP_PHASH_SCAN_LIMIT=500

# ============ Giới hạn an toàn ============
MONTHLY_BUDGET_USD=200
MAX_CONCURRENT_RENDERS=2
MAX_VIDEO_DURATION_SEC=600
DOWNLOAD_TIMEOUT_SEC=600
FFMPEG_TIMEOUT_SEC=1800

# ============ Nền tảng đăng (M5) ============
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ============ Tải video ============
# Một số nền tảng (Douyin) từ chối request không có cookie, kể cả cookie khách
# chưa đăng nhập. Chỉ cần mở trang đó một lần trong trình duyệt bên dưới.
# chrome | firefox | edge | safari — CHỈ dùng được khi worker chạy thẳng trên máy
YTDLP_COOKIES_FROM_BROWSER=
# File cookie dạng Netscape — cách duy nhất chạy được trong Docker
YTDLP_COOKIE_FILE=
