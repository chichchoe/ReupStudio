# ============ Hạ tầng ============
DATABASE_URL=postgresql+psycopg://reup:reup@localhost:5432/reup
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./media
API_BASE_URL=http://localhost:8000

# ============ AI: dịch thuật ============
# anthropic | openai | google | mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BATCH_SIZE=25

# ============ AI: nhận dạng giọng nói ============
# tiny | base | small | medium | large-v3
WHISPER_MODEL=large-v3
# cuda | cpu | auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16

# ============ Phụ đề ============
SUB_FONT=Be Vietnam Pro
SUB_FONT_SIZE=54
SUB_MAX_CHARS_PER_LINE=42
SUB_MAX_LINES=2
SUB_MIN_DURATION=1.2

# ============ Giới hạn an toàn ============
MONTHLY_BUDGET_USD=200
MAX_CONCURRENT_RENDERS=2
MAX_VIDEO_DURATION_SEC=600
DOWNLOAD_TIMEOUT_SEC=600
FFMPEG_TIMEOUT_SEC=1800

# ============ Nền tảng đăng (M5) ============
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
