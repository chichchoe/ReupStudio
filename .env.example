# ReupStudio — chỉ còn BA biến ở file này.
#
# Mọi cấu hình khác (khoá API, model, giới hạn, phụ đề, chống trùng…) đã chuyển
# vào bảng `app_settings` và sửa được ở trang Cấu hình trên giao diện.
#
# Lý do: file này nằm cạnh mã nguồn nên chỉ cần một lần `git add -A` bất cẩn là
# khoá API lên GitHub.
#
# Ba biến dưới đây KHÔNG chuyển được, vì chúng cần TRƯỚC khi chạm được DB.

# Dùng để tới chính bảng app_settings.
DATABASE_URL=postgresql+psycopg://reup:reup@localhost:5432/reup

# Worker cần lúc khởi động, trước khi có DB.
REDIS_URL=redis://localhost:6379/0

# Khoá giải mã cột value_encrypted của app_settings — bí mật DUY NHẤT còn phải
# nằm ngoài DB. Sinh khoá ở trang Cấu hình, hoặc bằng lệnh:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ĐỔI khoá này sẽ làm mọi bí mật đang lưu KHÔNG giải mã được nữa.
SETTINGS_KEY=

# ---------------------------------------------------------------------------
# Chuyển từ bản cũ sang: xem trước rồi ghi vào DB, sau đó xoá tay các dòng cũ
# khỏi .env, giữ lại đúng ba biến trên.
#
#   python scripts/chuyen_env_vao_db.py
#   python scripts/chuyen_env_vao_db.py --ghi
